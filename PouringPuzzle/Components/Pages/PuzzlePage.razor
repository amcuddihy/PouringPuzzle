@using PouringPuzzle.Models
@using PouringPuzzle.Services
@using System.Diagnostics
@using PouringPuzzle.ViewModels

@page "/"
@rendermode InteractiveServer

@inject PuzzleSetupViewModel SetupViewModel;
@inject PuzzleViewModel GameViewModel;

<div style="display: flex; flex-direction: column; align-items: center;">

    <div style="display: inline-block; text-align: left; margin: 0 auto;">
        <PuzzleSetup />
    </div>

    <div style="width: 40%; height: 2px; background-color: #444; margin: 20px;"></div>

    @if (!GameViewModel.PuzzleHasSolution) {
        <div style="
            background-color: #ffe5e5;
            color: #cc0000;
            border: 1px solid #cc0000;
            padding: 6px 12px;
            border-radius: 4px;
            margin: 10px 0;
            font-weight: bold;
            text-align: center;">
            ⚠️ This puzzle has no solution.
        </div>
    }

    <div style="display: flex; flex-direction: row; align-items: flex-end;">
        @foreach (var vessel in GameViewModel.Vessels)
        {
            <VesselComponent VesselModel="vessel"/>
        }
    </div>

    <h5>Move:</h5>
    <div>
        <label>From: </label>
        <input type="number" @bind="GameViewModel.Sender"/>

        <label> To: </label>
        <input type="number" @bind="GameViewModel.Receiver"/>
    </div>

    <div style="display: flex; flex-direction: row; gap: 10px;">
        <button @onclick="Pour">Pour</button>
        <button @onclick="SuggestMove">Suggest Move</button>
        <button @onclick="GetSolution">Display Solution</button>
    </div>

    @foreach (var move in GameViewModel.SolutionMoves) {
        <h6>@move.From => @move.To</h6>
    }

</div>

@if (GameViewModel.ShowVictoryPopup) {
    <div class="popup-overlay">
        <div class="popup-box">
            <h2>You Win!</h2>
            <p>Congratulations! 🎉</p>
            <button @onclick="HideVictoryPopup">Close</button>
        </div>
    </div>
}

@code {
    protected override void OnInitialized() {
        SetupViewModel.SetupChanged += OnSetupChanged;
        GameViewModel.Vessels = new List<Vessel>(SetupViewModel.Vessels);
        GameViewModel.GeneratePuzzle(SetupViewModel.Vessels, SetupViewModel.Goal);
    }

    private void OnSetupChanged() {
        GameViewModel.Vessels = new List<Vessel>(SetupViewModel.Vessels);
        GameViewModel.GeneratePuzzle(SetupViewModel.Vessels, SetupViewModel.Goal);
        if (GameViewModel.SolutionMoves.Count > 0) {
            GameViewModel.ShowSolution();
        }
        StateHasChanged();
    }

    private void Pour() {
        GameViewModel.Pour();

        if (GameViewModel.SolutionMoves.Count > 0) { //TODO: use a bool to show/hide solution, this will allow list to reappear if player moves off goal node
            GetSolution();             
        }
    }

    private void SuggestMove() {
        GameViewModel.SuggestMove();
    }

    private void GetSolution() {
        GameViewModel.ShowSolution();
    }

    private void HideVictoryPopup() {
        GameViewModel.ShowVictoryPopup = false;
    }
}
