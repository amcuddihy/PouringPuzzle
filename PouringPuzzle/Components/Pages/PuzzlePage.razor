@using PouringPuzzle.Models
@using PouringPuzzle.Services
@using System.Diagnostics
@using PouringPuzzle.ViewModels

@page "/"
@rendermode InteractiveServer

@inject PuzzleViewModel ViewModel;

@* <body style="background-color: #f9f9f9;"> *@

<div style="display: flex; flex-direction: column; align-items: center;"> 

    <!-- Puzzle Setup Div -->
    <div style="background-color: white;
            border: 1px solid #ccc;
            padding: 16px;
            border-radius: 8px;
            box-shadow: 2px 2px 6px rgba(0,0,0,0.1);
            margin-bottom: 20px 0; 
            display: inline-block; 
            text-align: left; 
            margin: 0 auto;">
        <div>
            <label>Vessels: </label>
            <input type="number" @bind="ViewModel.VesselCount" />
        </div>

        @for (int i = 0; i < ViewModel.VesselCount; i++) 
        {
            var index = i; // Capture the current value of i for use in the data binding

            @if (i == 0 && ViewModel.UseTapAndDrain) 
            {
                <div>Faucet and Sink</div>
            }
            else 
            {
                <div>
                    <label>Vessel | </label>
                    <label>Size: </label>
                    <input type="number" @bind="ViewModel.Vessels[index].MaxValue" />
                    <label>Start: </label>
                    <input type="number" @bind="ViewModel.Vessels[index].StartingValue" />
                </div>
            }
        }

        <div>
            <label>"Faucet and Sink" Mode </label>
            <input type="checkbox" @bind="ViewModel.UseTapAndDrain" />
        </div>

        <div>
            <label>Goal: </label>
            <input type="number" @bind="ViewModel.Goal" />
        </div>
    </div>

    <!-- Divider -->
    <div style="width: 40%; height: 2px; background-color: #444; margin: 20px 0;"></div>
     
    <!-- Puzzle Play Div -->
    <div style="background-color: white;
        border: 1px solid #ccc;
        padding: 16px;
        border-radius: 8px;
        box-shadow: 2px 2px 6px rgba(0,0,0,0.1);
        margin-bottom: 20px 0;
        display: flex;
        flex-direction: column;
        align-items: center;">

        @if (!ViewModel.PuzzleHasSolution) {
            <div style="
                background-color: #ffe5e5;
                color: #cc0000;
                border: 1px solid #cc0000;
                padding: 6px 12px;
                border-radius: 4px;
                margin: 10px 0;
                font-weight: bold;
                text-align: center;">
                ⚠️ This puzzle has no solution.
            </div>
        }

        <div style="display: flex; flex-direction: row; align-items: flex-end;">
            @for (int i = 0; i < ViewModel.VesselCount; i++)
            {
                <VesselComponent 
                    MaxValue="ViewModel.Vessels[i].MaxValue" 
                    CurrentValue="ViewModel.CurrentNode.VesselValues[i]" 
                    IsSink="@(i == 0 && ViewModel.UseTapAndDrain)"/>
            }
        </div>

        <h5>Move:</h5>
        <div>
            <label>From: </label>
            <input type="number" @bind="ViewModel.Sender"/>

            <label> To: </label>
            <input type="number" @bind="ViewModel.Receiver"/>
        </div>

        <div style="display: flex; flex-direction: row; gap: 10px; margin: 20px 0">
            <button @onclick="ViewModel.Pour">Pour</button>
            <button @onclick="ViewModel.SuggestMove">Suggest Move</button>
        </div>
    </div> 
</div>

@if (ViewModel.ShowVictoryPopup) {
    <div class="popup-overlay">
        <div class="popup-box">
            <h2>You Win!</h2>
            <p>Congratulations! 🎉</p>
            <button @onclick="ViewModel.HideVictoryPopup">Close</button>
        </div>
    </div>
}
